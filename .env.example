# Everything is optional: with nothing set, the app serves the free local
# engines (PDF text + in-browser OCR) and bring-your-own-key AI.

# Hosted AI (free daily quota + credits) needs all four:
ANTHROPIC_API_KEY=
DATABASE_URL=            # Postgres (Neon pooled URL on Vercel)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Buying credits additionally needs:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=   # endpoint: https://<host>/api/stripe/webhook (checkout.session.completed)

APP_URL=http://localhost:5173
CREDIT_MARKUP_BPS=1500   # 15% on top of Anthropic's token cost
FREE_PAGES_PER_DAY=25    # Fast-tier pages per signed-in user per UTC day
