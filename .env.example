# Everything is optional: with nothing set, the app serves the free local
# engines (PDF text + in-browser OCR) and bring-your-own-key AI.

# Hosted AI (free daily quota + credits) needs all four:
ANTHROPIC_API_KEY=
DATABASE_URL=            # Postgres (pooled is fine)
DATABASE_URL_UNPOOLED=   # direct URL for migrations (session advisory lock); Neon's Vercel integration sets both
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Buying credits additionally needs:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=   # endpoint https://<host>/api/stripe/webhook; events: checkout.session.completed,
                         # checkout.session.async_payment_succeeded, charge.refunded
STRIPE_PRICE_IDS=        # optional catalog prices: 1000=price_…,2500=price_…,5000=price_… (else inline)
# The Stripe account must have Managed Payments enabled (Settings → Managed Payments).

APP_URL=http://localhost:5173
CREDIT_MARKUP_BPS=1500   # 15% on top of Anthropic's token cost
FREE_PAGES_PER_DAY=25    # Fast-tier pages per signed-in user per UTC day

# Abuse controls (SECURITY.md lists them all). Free caps: -1 = unlimited, 0 = off.
FREE_PAGES_PER_IP_PER_DAY=40     # free pages per caller IP per UTC day, across accounts
FREE_PAGES_GLOBAL_PER_DAY=2000   # all free pages per UTC day; 0 is the kill switch
RATE_EXTRACT_PER_MINUTE=30       # hosted /api/extract calls per user (0 disables)
RATE_CHECKOUT_PER_MINUTE=5       # /api/checkout calls per user (0 disables)
IP_HASH_SECRET=                  # HMAC key for stored IP hashes (default: derived from CLERK_SECRET_KEY)
CLERK_AUTHORIZED_PARTIES=        # allowed token origins (azp); default pdfcells.com, www, localhost:5173

# Inbound mail for @pdfcells.com via Resend receiving → forwarded to one inbox.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=   # whsec_… from the email.received webhook pointing at /api/inbound
INBOUND_FORWARD_TO=
