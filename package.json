{
  "name": "pdfcells",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "go run ./cmd/server",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --config oxlintrc.json --deny-warnings src",
    "fmt": "oxfmt --write src",
    "fmt:check": "oxfmt --check src",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@clerk/react": "^6.17.8",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "write-excel-file": "^4.1.1"
  }
}
